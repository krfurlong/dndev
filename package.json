{
  "name": "dndev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/security/**",
    "test:security": "firebase emulators:exec --project demo-dndev --only firestore,auth \"vitest run tests/security\"",
    "test:e2e": "playwright test",
    "catalog:refresh": "node scripts/catalog-refresh.mjs",
    "catalog:check": "node scripts/catalog-check.mjs",
    "campaign:key": "node scripts/campaign-key.mjs"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "firebase": "12.19.0",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workbox-window": "^7.4.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cheerio": "1.2.0",
    "fake-indexeddb": "6.2.5",
    "firebase-tools": "15.30.1",
    "prettier": "3.9.7",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  }
}
